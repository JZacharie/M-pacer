# Gabarit des secrets locaux de M-pacer.
# Copiez ce fichier en `.env` (ignore par git) et renseignez vos valeurs.
# Aucun secret ne doit etre ecrit ici : ce fichier est versionne.

# ---------------------------------------------------------------- suivi en direct
# Broker MQTT qui recoit les positions publiees par la montre (docs/10).
# Vide ou absent => suivi desactive (aucune connexion ouverte).
MPACER_MQTT_URL=mqtt://192.168.0.115:1883
MPACER_MQTT_TOPIC=mpacer/live/+
MPACER_MQTT_USERNAME=
MPACER_MQTT_PASSWORD=

# Test d'integration contre un broker reel (ignore par defaut) :
#   cargo test -p mpacer-api --test mqtt_live -- --ignored
MPACER_MQTT_TEST_URL=
MPACER_MQTT_TEST_TOPIC=mpacer/live/mpacer-test

# ------------------------------------------------- Deezer, Deemix et MP3
# Cookie "arl" du compte Deezer : deezer.com > DevTools > Application >
# Cookies > https://www.deezer.com > arl. Aucune application developpeur n'est
# necessaire ; les playlists du compte (privees comprises) deviennent lisibles.
# Vide => la source Deezer reste annoncee "non configuree" sur /music.
MPACER_DEEZER_ARL=

# Instance Deemix utilisee pour telecharger les MP3 listes par /music.
# Vide => https://deemix.p.zacharie.org
MPACER_DEEMIX_URL=

# Authentification HTTP basique de l'instance Deemix (Traefik). Avec le cookie
# arl ci-dessus, /music ENVOIE les playlists dans la file de Deemix (bouton
# « Telecharger dans Deemix ») et affiche la progression des telechargements.
# Sans ces deux valeurs, la page se contente des liens vers Deemix.
MPACER_DEEMIX_USER=
MPACER_DEEMIX_PASSWORD=

# Test d'integration contre l'API Deezer reelle (ignore par defaut) :
#   MPACER_DEEZER_ARL="<cookie arl>" cargo test -p mpacer-api --test deezer_live -- --ignored

# ------------------------------------------------- courses : recherche Finishers
# Recherche dans le calendrier https://www.finishers.com/ou-courir/europe/france
# (page /courses/recherche et GET /api/v1/races/search). L'index Typesense du
# site est interroge en lecture seule, avec la cle publique livree dans son
# JavaScript : rien a renseigner pour que la recherche fonctionne.
# MPACER_FINISHERS_DISABLED=1 eteint la fonctionnalite (aucun appel reseau).
MPACER_FINISHERS_DISABLED=
# A renseigner seulement si Finishers change d'hote ou de cle de lecture.
MPACER_FINISHERS_HOST=
MPACER_FINISHERS_API_KEY=
MPACER_FINISHERS_COLLECTION=

# ------------------------------------------------------------------ backend local
MPACER_DATABASE_URL=postgresql://mpacer:mpacer@127.0.0.1:5432/mpacer?sslmode=disable
MPACER_DEV_AUTH=1
MPACER_PUBLIC_URL=http://localhost:8080

# ------------------------------------------- autres appareils du reseau local
# (wifi du boitier, serveur web, OTA, cle de chiffrement : non lus par M-pacer)
mqtt_endpoint=
mqtt_user=
mqtt_password=
wifi_ssid=
wifi_psk=
wifi_password=
web_server_password=
ota_password=
fallback_password=
encryption_key=
api_encryption_key=

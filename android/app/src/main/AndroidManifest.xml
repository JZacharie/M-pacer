<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />
    <!-- Le capteur cardiaque n'est pas obligatoire : sans lui la seance est complete,
         il manque seulement les zones et la derive cardiaque. -->
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ : un type est obligatoire pour un service de premier plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lecture musicale pendant la course : service de premier plan de type mediaPlayback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Frequence cardiaque (capteur de la montre) : zones, derive, export GPX -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Synchronisation des seances vers le backend auto-heberge (SyncClient) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lecture audio locale : session medias Media3 (ExoPlayer).
             Les fichiers joues sont ceux copies par USB dans Music/ (docs/07 v2) ;
             aucune application tierce n est pilotee. -->
        <service
            android:name=".music.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Seance en cours : GPS sans le telephone, ecran eteint -->
        <service
            android:name=".TrackingService"
            android:exported="false"
            android:foregroundServiceType="location|health" />

        <!-- Reception des seances envoyees par le module :companion (Wearable Data Layer).
             Meme paquet/signature exiges cote telephone pour que le routage fonctionne. -->
        <service
            android:name=".WearSyncListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/mpacer" />
            </intent-filter>
        </service>
    </application>
</manifest>

# M-pacer — projet Connect IQ
#
# `project.manifest` est obligatoire : monkeyc lit le manifeste déclaré ici.
# Les chemins source/ressources sont ensuite déclarés explicitement pour que le
# build soit reproductible en ligne de commande comme dans VS Code.

project.manifest = manifest.xml
# Le dossier source precedent, puis le source genere par build.ps1 : il porte la
# version et le jour de compilation (build/gen/MpacerBuildInfo.mc), affiches
# dans l'ecran Reglages de la montre.
base.sourcePath = source;build/gen
base.resourcePath = resources
